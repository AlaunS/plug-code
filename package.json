{
  "name": "plug-code",
  "version": "2.0.0",
  "description": "A reactive state management and UI framework for React",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./simple": {
      "import": "./dist/simple.js",
      "require": "./dist/simple.js",
      "types": "./dist/simple.d.ts"
    },
    "./types": {
      "import": "./dist/types/core/index.js",
      "require": "./dist/types/core/index.js",
      "types": "./dist/types/core/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "keywords": [
    "react",
    "state-management",
    "framework",
    "reactive",
    "ui"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "immer": "^11.1.3",
    "react": "^19.2.3"
  }
}
